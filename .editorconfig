# EditorConfig -- consistent style for this project
# https://editorconfig.org/

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[{Dockerfile*,*.yml}]
indent_style = space
indent_size = 2

[{*.sh,build/*.sh,root/etc/s6-overlay/s6-rc.d/**/run,root/etc/s6-overlay/s6-rc.d/**/up}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

