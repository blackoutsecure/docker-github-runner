#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# Thin orchestrator for runner first-time setup.
#
# Every step here is implemented in a focused helper module under
# /usr/local/bin/gh-*.sh. This file only:
#   1. sources the helpers
#   2. calls them in dependency order
#   3. wraps long steps in stage_begin/stage_end so operators see progress
#
# If you find yourself adding a function body in this file, push it into
# one of the gh-*.sh modules instead so other entry points (autoscale,
# heartbeat service, future tools) can share it.
#
set -euo pipefail

# Shared libraries (load first; helpers depend on log/banner functions).
# LOG_TAG must be set BEFORE sourcing log-functions.sh: the library
# checks for it at source time and warns "unknown" otherwise.
LOG_TAG="init-gh-runner-config"
# shellcheck disable=SC1091
. /usr/local/bin/log-functions.sh
# shellcheck disable=SC1091
. /usr/local/bin/banner-functions.sh

# shellcheck disable=SC1091
. /usr/local/bin/gh-config.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-runtime.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-api.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-dind.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-preflight.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-cleanup.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-banner.sh

log "info" "Initializing GitHub Actions self-hosted runner"

# ---------------------------------------------------------------------------
# 1. Detect user mode + validate LOG_LEVEL + ephemeral-aware defaults
# ---------------------------------------------------------------------------
gh_runtime_detect_user_mode
gh_config_validate_log_level
gh_config_resolve_idle_recycle
gh_config_resolve_runtime_tunables
log "info" "Log level: ${LOG_LEVEL:-info}"

# ---------------------------------------------------------------------------
# 2. Filesystem fix-ups
# ---------------------------------------------------------------------------
stage_begin "environment & path setup"
RUNNER_DIR="/opt/runner-bin"
export RUNNER_DIR
gh_runtime_fix_tmp
gh_runtime_fix_runner_dir "${RUNNER_DIR}"
cleanup_stale_artifacts
stage_end

# ---------------------------------------------------------------------------
# 3. Resolve secrets (VAR_FILE -> VAR)
# ---------------------------------------------------------------------------
stage_begin "secret resolution (RUNNER_TOKEN / GITHUB_PAT / GITHUB_TOKEN / RUNNER_URL)"
gh_config_resolve_runner_secrets
stage_end

# ---------------------------------------------------------------------------
# 4. Mint a registration token via PAT/GITHUB_TOKEN when RUNNER_TOKEN absent
# ---------------------------------------------------------------------------
if [[ -z "${RUNNER_TOKEN:-}" ]]; then
    stage_begin "minting registration token via GitHub API"
    if [[ -n "${GITHUB_PAT:-}" ]]; then
        gh_api_generate_registration_token "${GITHUB_PAT}" "GITHUB_PAT"
    elif [[ -n "${GITHUB_TOKEN:-}" ]]; then
        gh_api_generate_registration_token "${GITHUB_TOKEN}" "GITHUB_TOKEN"
    fi
    stage_end
fi

# ---------------------------------------------------------------------------
# 5. Validate required inputs now that all secret paths have been resolved
# ---------------------------------------------------------------------------
if [[ -z "${RUNNER_URL:-}" ]]; then
    log "fatal" "RUNNER_URL or RUNNER_URL_FILE is required (e.g. https://github.com/owner/repo)"
    exit 1
fi
if [[ -z "${RUNNER_TOKEN:-}" ]]; then
    log "fatal" "One of the following is required to authenticate:"
    log "fatal" "  RUNNER_TOKEN / RUNNER_TOKEN_FILE  -- pre-generated registration token (expires in 1h)"
    log "fatal" "  GITHUB_PAT   / GITHUB_PAT_FILE   -- long-lived PAT to auto-generate tokens via API"
    log "fatal" "  GITHUB_TOKEN / GITHUB_TOKEN_FILE  -- repo secret or Actions token (e.g. \${{ secrets.MY_TOKEN }})"
    exit 1
fi

# ---------------------------------------------------------------------------
# 6. Identity defaults: name, labels, workdir
# ---------------------------------------------------------------------------
gh_config_resolve_runner_name
gh_config_resolve_runner_labels
gh_config_resolve_runner_workdir

# ---------------------------------------------------------------------------
# 7. Docker-in-Docker socket plumbing (no-op when DOCKER_IN_DOCKER=false)
# ---------------------------------------------------------------------------
gh_dind_setup

# ---------------------------------------------------------------------------
# 8. Pre-flight + stale-runner cleanup + runner-group + dedupe
# ---------------------------------------------------------------------------
cd /opt/runner-bin

stage_begin "pre-flight permission & environment checks"
gh_preflight_run
stage_end

stage_begin "stale offline-runner cleanup (CLEANUP_OFFLINE_RUNNERS=${CLEANUP_OFFLINE_RUNNERS:-false})"
cleanup_stale_offline_runners
stage_end

stage_begin "runner-group check (RUNNER_GROUP=${RUNNER_GROUP:-Default})"
gh_api_ensure_runner_group "${RUNNER_GROUP:-Default}"
stage_end

stage_begin "runner name deduplication (base='${RUNNER_NAME}')"
RUNNER_NAME="$(gh_api_deduplicate_runner_name "${RUNNER_NAME}")"
export RUNNER_NAME
log "info" "Final runner name: ${RUNNER_NAME}"
stage_end

# ---------------------------------------------------------------------------
# 9. Register runner with GitHub (or reuse + sync an existing .runner file)
# ---------------------------------------------------------------------------
if [[ -f ".runner" ]] && [[ "${RUNNER_EPHEMERAL:-false}" != "true" ]]; then
    # Verify the existing config still points to the same URL & name. If
    # it does, sync labels/group via the API and skip re-registration.
    local_url="$(jq -r '.gitHubUrl // empty' .runner 2>/dev/null)"
    local_name="$(jq -r '.agentName // empty' .runner 2>/dev/null)"

    if [[ "${local_url}" == "${RUNNER_URL}" && "${local_name}" == "${RUNNER_NAME}" ]]; then
        log "info" "Runner already configured (found .runner file), skipping reconfiguration"
        gh_api_sync_existing_runner_metadata \
            "${RUNNER_NAME}" \
            "${RUNNER_LABELS:-}" \
            "${RUNNER_GROUP:-Default}"
    else
        log "info" "Runner config mismatch (local: ${local_name}@${local_url}, wanted: ${RUNNER_NAME}@${RUNNER_URL})"
        log "info" "Attempting to deregister old runner before reconfiguring"
        as_runner_user ./config.sh remove --token "${RUNNER_TOKEN}" 2>/dev/null || {
            log "warn" "Local deregistration failed (token scope may differ); cleaning local config"
            clean_local_runner_config
        }
        # Fall through to the configuration block below.
    fi
fi

if [[ ! -f ".runner" ]]; then
    stage_begin "runner registration via config.sh (this contacts GitHub and may take a few seconds)"
    log "info" "Configuring runner..."
    log "info" "  URL:       ${RUNNER_URL}"
    log "info" "  Name:      ${RUNNER_NAME}"
    log "info" "  Work dir:  ${RUNNER_WORKDIR}"
    log "info" "  Ephemeral: ${RUNNER_EPHEMERAL:-false}"
    log "info" "  Labels:    ${RUNNER_LABELS:-default}"
    log "info" "  Group:     ${RUNNER_GROUP:-Default}"

    CONFIG_ARGS=(
        --unattended
        --url "${RUNNER_URL}"
        --token "${RUNNER_TOKEN}"
        --name "${RUNNER_NAME}"
        --work "${RUNNER_WORKDIR}"
        --replace
    )
    [[ -n "${RUNNER_LABELS:-}" ]] && CONFIG_ARGS+=(--labels "${RUNNER_LABELS}")
    [[ -n "${RUNNER_GROUP:-}"  ]] && CONFIG_ARGS+=(--runnergroup "${RUNNER_GROUP}")
    [[ "${RUNNER_EPHEMERAL:-false}"    == "true" ]] && CONFIG_ARGS+=(--ephemeral)
    [[ "${DISABLE_RUNNER_UPDATE:-false}" == "true" ]] && CONFIG_ARGS+=(--disableupdate)

    # Run config.sh under a `timeout` wrapper so a wedged TCP connection
    # to api.github.com can't hang init forever. SIGTERM at CONFIG_TIMEOUT,
    # SIGKILL 5s later. When CONFIG_TIMEOUT=0 we drop the wrapper entirely
    # (legacy behaviour, useful for slow / first-time setups behind very
    # poor links). On timeout the exit code is 124 which trips the same
    # retry / API-removal fallback as a true config.sh error.
    _run_config_sh() {
        if (( CONFIG_TIMEOUT > 0 )); then
            as_runner_user timeout --kill-after=5s "${CONFIG_TIMEOUT}s" \
                ./config.sh "${CONFIG_ARGS[@]}" 2>&1
        else
            as_runner_user ./config.sh "${CONFIG_ARGS[@]}" 2>&1
        fi
    }

    # First attempt -- capture combined stdout/stderr to inspect failures.
    config_output=""
    if ! config_output="$(_run_config_sh)"; then
        config_rc=$?
        printf '%s\n' "${config_output}" | prefix_lines config

        # timeout(1) exits 124 (SIGTERM) or 137 (SIGKILL) on hard cap.
        if [[ "${config_rc}" == "124" || "${config_rc}" == "137" ]]; then
            log "warn" "config.sh exceeded CONFIG_TIMEOUT=${CONFIG_TIMEOUT}s (rc=${config_rc}) -- treating as transient and retrying"
        fi

        # Bail early on label validation errors (retry won't help).
        if echo "${config_output}" | grep -qi "Label.*is not valid"; then
            log "fatal" "config.sh failed due to invalid labels: ${RUNNER_LABELS}"
            log "fatal" "Ensure labels do not contain leading/trailing spaces and are under 256 characters"
            exit 1
        fi

        log "warn" "config.sh failed -- likely a name conflict or stale registration"

        # Try to force-remove the conflicting runner via the API and retry.
        if gh_api_remove_runner_by_name "${RUNNER_NAME}"; then
            log "info" "Retrying config.sh after API removal..."
            clean_local_runner_config
            if ! _run_config_sh | prefix_lines config; then
                log "fatal" "config.sh failed AFTER API removal of conflicting runner -- giving up"
                log "fatal" "Check the 'config' output lines above for the underlying error from the runner registration"
                exit 1
            fi
        else
            log "fatal" "Unable to resolve runner name conflict for '${RUNNER_NAME}'"
            log "fatal" "Ensure the PAT has admin scope or manually remove the stale runner from GitHub"
            exit 1
        fi
    else
        printf '%s\n' "${config_output}" | prefix_lines config
    fi

    log "info" "Runner configured successfully"
    stage_end
fi

# ---------------------------------------------------------------------------
# 10. Persist key vars for downstream services + load optional env file/dir
# ---------------------------------------------------------------------------
mkdir -p /run/s6/container_environment
printf '%s' "${RUNNER_NAME}"    > /run/s6/container_environment/RUNNER_NAME
printf '%s' "${RUNNER_URL}"     > /run/s6/container_environment/RUNNER_URL
printf '%s' "${RUNNER_WORKDIR}" > /run/s6/container_environment/RUNNER_WORKDIR

gh_runtime_load_env_file
gh_runtime_load_secrets_dir

# ---------------------------------------------------------------------------
# 11. Emit the operator-visible startup banner
# ---------------------------------------------------------------------------
gh_config_resolve_heartbeat   # so the banner shows resolved heartbeat values
gh_banner_emit | prefix_lines banner

sync 2>/dev/null || true
log "info" "Runner initialization complete -- handing off to s6 to launch svc-gh-runner"
sync 2>/dev/null || true
