#!/usr/bin/with-contenv bash
# shellcheck shell=bash
#
# Thin orchestrator for the runner log tailer + heartbeat.
#
# Responsibilities (delegated to helpers):
#   - gh-config.sh     : validate / resolve heartbeat tunables
#   - gh-api.sh        : online probe (gh_api_probe_runner_online)
#   - gh-diag.sh       : tail _diag/*.log with NOISE_RE / BENIGN_WARN_RE
#                        filtering and per-line severity gating
#   - gh-heartbeat.sh  : emit_worker_banner / emit_health_banner /
#                        WORKER_START_TS tracking
#   - gh-runtime.sh    : format_duration_human
#
# This file owns ONLY the main loop: detect new log files, track worker
# lifecycle, fire heartbeats, refresh sentinel, escalate on offline /
# idle-recycle thresholds.
#
set -uo pipefail

# shellcheck disable=SC1091
. /usr/local/bin/log-functions.sh
# shellcheck disable=SC1091
. /usr/local/bin/banner-functions.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-config.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-runtime.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-api.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-diag.sh
# shellcheck disable=SC1091
. /usr/local/bin/gh-heartbeat.sh

LOG_TAG="svc-gh-runner-logs"

# Capture true service start time BEFORE we block on any wait. Uptime in
# the heartbeat banner should reflect how long this service has been
# alive, not how long since Runner.Listener appeared (which may be tens
# of seconds later on slow ARM cold-start).
STARTED_AT="$(date +%s)"
# Only tail logs whose mtime is at/after this point (skip stale logs from
# previous container lifetimes -- otherwise they'd be replayed and spam
# the console with old errors after every restart).
TAIL_FROM_TS="$(( STARTED_AT - 5 ))"

# Resolve every heartbeat tunable in one shot (HEARTBEAT_INTERVAL,
# JOB_HEARTBEAT_INTERVAL, ONLINE_PROBE_EVERY, ONLINE_FAIL_THRESHOLD,
# ON_OFFLINE_ACTION, IDLE_RECYCLE_ACTION, HEALTH_STALE_AFTER) plus the
# ephemeral-aware IDLE_RECYCLE_AFTER default and the loop/wait tunables
# (LOG_WATCH_INTERVAL, LISTENER_WAIT_TIMEOUT, DIAG_WAIT_TIMEOUT).
gh_config_resolve_heartbeat
gh_config_resolve_idle_recycle
gh_config_resolve_runtime_tunables

DIAG_DIR="/opt/runner-bin/_diag"
SENTINEL_DIR="/run/gh-runner"
SENTINEL_FILE="${SENTINEL_DIR}/online"
mkdir -p "${SENTINEL_DIR}"

# Bounded wait for the diag directory. Without a cap a broken install
# (Runner.Listener never writes its first log) silently spins forever
# and the heartbeat is never emitted, making "is anything happening?"
# impossible to answer from `docker logs`.
_wait_start="$(date +%s)"
_warned_at=0
while [[ ! -d "${DIAG_DIR}" ]]; do
    _now="$(date +%s)"
    _waited=$(( _now - _wait_start ))
    if (( DIAG_WAIT_TIMEOUT > 0 && _waited >= DIAG_WAIT_TIMEOUT )); then
        log "warn" "Timed out (${_waited}s) waiting for ${DIAG_DIR} to appear -- continuing without diag tailing; check init-gh-runner-config logs"
        break
    fi
    if (( _now - _warned_at >= 30 && _waited >= 30 )); then
        log "warn" "Still waiting for ${DIAG_DIR} after ${_waited}s -- Runner.Listener has not produced its first log yet"
        _warned_at="${_now}"
    fi
    sleep 1
done

# Bounded wait for Runner.Listener. If init succeeded but the listener
# crashed during JIT compile / handshake, we want a warning rather than
# eternal silence.
_wait_start="$(date +%s)"
_warned_at=0
while ! pgrep -f 'Runner.Listener' >/dev/null 2>&1; do
    _now="$(date +%s)"
    _waited=$(( _now - _wait_start ))
    if (( LISTENER_WAIT_TIMEOUT > 0 && _waited >= LISTENER_WAIT_TIMEOUT )); then
        log "warn" "Timed out (${_waited}s) waiting for Runner.Listener -- continuing; the heartbeat will report 'offline' until the process appears"
        break
    fi
    if (( _now - _warned_at >= 30 && _waited >= 30 )); then
        log "warn" "Still waiting for Runner.Listener after ${_waited}s -- registration may have failed; inspect 'config' lines above"
        _warned_at="${_now}"
    fi
    sleep 1
done

log "info" "Runner process is live (${RUNNER_NAME:-$(hostname)}) -- listening for jobs"

TAILED=""
LAST_HEARTBEAT="${STARTED_AT}"
HEARTBEAT_TICK=0
OFFLINE_STREAK=0
PREV_WORKER_PIDS=""
JOB_ACTIVE=0
LAST_JOB_TICK=0
CURRENT_STATE="starting"
STATE_SINCE_TS="${STARTED_AT}"

# Seed the sentinel so the healthcheck doesn't flap during the start window.
date -u +'%Y-%m-%dT%H:%M:%SZ' > "${SENTINEL_FILE}"

# Pre-mark all but the newest pre-existing log as already-tailed. config.sh
# creates a transient _diag log during registration that finalises a few
# seconds before the listener writes its own log; without this both end up
# in the tail set (visible as duplicate "Tailing Runner_*.log" lines and
# replayed setup output). Keep only the most recent one -- the listener
# log -- and let the main loop pick up any new files that appear later.
shopt -s nullglob
_existing_logs=( "${DIAG_DIR}"/*.log )
shopt -u nullglob
if (( ${#_existing_logs[@]} > 1 )); then
    _newest=""
    _newest_mtime=0
    for f in "${_existing_logs[@]}"; do
        m="$(stat -c %Y "${f}" 2>/dev/null || echo 0)"
        if (( m > _newest_mtime )); then
            _newest_mtime="${m}"
            _newest="${f}"
        fi
    done
    for f in "${_existing_logs[@]}"; do
        if [[ "${f}" != "${_newest}" ]]; then
            TAILED="${TAILED} ${f}"
        fi
    done
    log "debug" "Skipping $((${#_existing_logs[@]} - 1)) pre-existing log file(s); will tail newest: ${_newest##*/}"
fi

while true; do
    # --- Tail any new log files (only from the current container run) ---
    shopt -s nullglob
    for f in "${DIAG_DIR}"/*.log; do
        if [[ "${TAILED}" == *"${f}"* ]]; then
            continue
        fi
        f_mtime="$(stat -c %Y "${f}" 2>/dev/null || echo 0)"
        if [[ "${f_mtime}" -lt "${TAIL_FROM_TS}" ]]; then
            continue
        fi
        TAILED="${TAILED} ${f}"
        log "info" "Tailing ${f##*/}"
        gh_diag_tail_file "${f}" &
    done
    shopt -u nullglob

    # --- Worker lifecycle tracking (JOB STARTED / JOB FINISHED banners) ---
    CURR_WORKER_PIDS="$(pgrep -f 'Runner.Worker' 2>/dev/null | sort -n | tr '\n' ' ')"
    CURR_WORKER_PIDS="${CURR_WORKER_PIDS% }"
    if [[ "${CURR_WORKER_PIDS}" != "${PREV_WORKER_PIDS}" ]]; then
        for pid in ${CURR_WORKER_PIDS}; do
            if [[ " ${PREV_WORKER_PIDS} " != *" ${pid} "* ]]; then
                WORKER_START_TS["${pid}"]="$(date +%s)"
                emit_worker_banner "STARTED" "${pid}" ""
            fi
        done
        for pid in ${PREV_WORKER_PIDS}; do
            if [[ " ${CURR_WORKER_PIDS} " != *" ${pid} "* ]]; then
                _start="${WORKER_START_TS[$pid]:-0}"
                _dur_extra=""
                if (( _start > 0 )); then
                    _dur=$(( $(date +%s) - _start ))
                    _dur_min=$(( _dur / 60 ))
                    _dur_sec=$(( _dur % 60 ))
                    _dur_extra="Duration         : ${_dur_min}m ${_dur_sec}s"
                fi
                emit_worker_banner "FINISHED" "${pid}" "${_dur_extra}"
                unset 'WORKER_START_TS[$pid]'
            fi
        done
        PREV_WORKER_PIDS="${CURR_WORKER_PIDS}"
    fi

    NOW="$(date +%s)"

    # Track coarse runner state continuously so heartbeat can report how
    # long we've been idle / running / offline.
    LISTENER_NOW=0
    pgrep -f 'Runner.Listener' >/dev/null 2>&1 && LISTENER_NOW=1
    NEW_STATE="offline"
    if (( LISTENER_NOW == 1 )); then
        if [[ -n "${CURR_WORKER_PIDS}" ]]; then
            NEW_STATE="running job"
        else
            NEW_STATE="idle"
        fi
    fi
    if [[ "${NEW_STATE}" != "${CURRENT_STATE}" ]]; then
        CURRENT_STATE="${NEW_STATE}"
        STATE_SINCE_TS="${NOW}"
    fi

    # --- Mini-heartbeat while a job is running ---
    if [[ -n "${CURR_WORKER_PIDS}" ]]; then
        if (( JOB_ACTIVE == 0 )); then
            JOB_ACTIVE=1
            LAST_JOB_TICK="${NOW}"
        elif (( JOB_HEARTBEAT_INTERVAL > 0 )) && (( NOW - LAST_JOB_TICK >= JOB_HEARTBEAT_INTERVAL )); then
            LAST_JOB_TICK="${NOW}"
            _up_s=$(( NOW - STARTED_AT ))
            _up_m=$(( _up_s / 60 ))
            _up_h=$(( _up_m / 60 ))
            _up_m=$(( _up_m % 60 ))
            _state_age="$(format_duration_human $(( NOW - STATE_SINCE_TS )))"
            emit_health_banner "JOB-HEARTBEAT" "running job" "" \
                "${_up_h}" "${_up_m}" "${CURR_WORKER_PIDS}" "${_state_age}"
        fi
    else
        JOB_ACTIVE=0
    fi

    # --- Periodic full heartbeat ---
    if (( NOW - LAST_HEARTBEAT >= HEARTBEAT_INTERVAL )); then
        UPTIME_SECS=$(( NOW - STARTED_AT ))
        UPTIME_MIN=$(( UPTIME_SECS / 60 ))
        UPTIME_HR=$(( UPTIME_MIN / 60 ))
        UPTIME_MIN=$(( UPTIME_MIN % 60 ))

        HEARTBEAT_TICK=$((HEARTBEAT_TICK + 1))
        LISTENER_ALIVE=0
        pgrep -f 'Runner.Listener' >/dev/null 2>&1 && LISTENER_ALIVE=1

        ONLINE_RESULT=2  # default: not probed
        if (( LISTENER_ALIVE == 1 )) \
           && (( ONLINE_PROBE_EVERY > 0 )) \
           && (( HEARTBEAT_TICK % ONLINE_PROBE_EVERY == 0 )); then
            gh_api_probe_runner_online "${RUNNER_NAME:-}"
            ONLINE_RESULT=$?
        fi

        STATUS_NOTE=""
        case "${ONLINE_RESULT}" in
            0) STATUS_NOTE="online (verified)" ;;
            1) STATUS_NOTE="OFFLINE per GitHub API" ;;
            2) STATUS_NOTE="" ;;
        esac

        if (( LISTENER_ALIVE == 1 )); then
            STATUS="${CURRENT_STATE}"
            STATE_AGE_SECS=$(( NOW - STATE_SINCE_TS ))
            STATE_AGE_HUMAN="$(format_duration_human "${STATE_AGE_SECS}")"

            # Refresh the sentinel ONLY when we either (a) have no API
            # check, or (b) the API confirms we're online. Prevents the
            # healthcheck from believing a process-alive-but-disconnected
            # runner is healthy.
            if (( ONLINE_RESULT != 1 )); then
                date -u +'%Y-%m-%dT%H:%M:%SZ' > "${SENTINEL_FILE}"
                OFFLINE_STREAK=0
            else
                OFFLINE_STREAK=$((OFFLINE_STREAK + 1))
            fi

            if [[ -n "${STATUS_NOTE}" ]]; then
                emit_health_banner "HEARTBEAT" "${STATUS}" "${STATUS_NOTE}" \
                    "${UPTIME_HR}" "${UPTIME_MIN}" "${CURR_WORKER_PIDS}" "${STATE_AGE_HUMAN}"
            else
                emit_health_banner "HEARTBEAT" "${STATUS}" "" \
                    "${UPTIME_HR}" "${UPTIME_MIN}" "${CURR_WORKER_PIDS}" "${STATE_AGE_HUMAN}"
            fi

            # Recycle long-idle runners if enabled. State timer resets
            # immediately when a worker starts, so active jobs are
            # unaffected.
            if (( IDLE_RECYCLE_AFTER > 0 )) && [[ "${STATUS}" == "idle" ]] \
               && (( STATE_AGE_SECS >= IDLE_RECYCLE_AFTER )); then
                log "warn" "Runner idle for ${STATE_AGE_HUMAN} (threshold=${IDLE_RECYCLE_AFTER}s); recycle action=${IDLE_RECYCLE_ACTION}"
                case "${IDLE_RECYCLE_ACTION}" in
                    restart)
                        log "warn" "Recycling idle runner by restarting svc-gh-runner"
                        s6-svc -r /run/service/svc-gh-runner 2>/dev/null \
                            || log "warn" "s6-svc restart failed; will retry on next heartbeat"
                        ;;
                    shutdown)
                        log "warn" "Recycling idle runner by shutting container down for fresh restart"
                        exec s6-svscanctl -t /run/service
                        ;;
                    none|*)
                        # Avoid warning spam when policy is log-only.
                        STATE_SINCE_TS="${NOW}"
                        ;;
                esac
            fi

            # Escalate if the API says offline for too many ticks in a row.
            if (( OFFLINE_STREAK >= ONLINE_FAIL_THRESHOLD )); then
                log "error" "Runner has been OFFLINE per GitHub API for ${OFFLINE_STREAK} consecutive checks (threshold: ${ONLINE_FAIL_THRESHOLD}); action=${ON_OFFLINE_ACTION}"
                case "${ON_OFFLINE_ACTION}" in
                    restart)
                        log "warn" "Restarting svc-gh-runner via s6 to attempt reconnection"
                        s6-svc -r /run/service/svc-gh-runner 2>/dev/null \
                            || log "warn" "s6-svc restart failed; will retry on next heartbeat"
                        OFFLINE_STREAK=0
                        ;;
                    shutdown)
                        log "warn" "Shutting container down so the orchestrator can restart it"
                        exec s6-svscanctl -t /run/service
                        ;;
                    none|*)
                        OFFLINE_STREAK=0
                        ;;
                esac
            fi
        else
            # Listener is gone -- don't refresh sentinel; healthcheck will fail.
            log "warn" "Heartbeat: Runner.Listener process not found -- may be restarting"
        fi
        LAST_HEARTBEAT="${NOW}"
    fi

    sleep "${LOG_WATCH_INTERVAL}"
done
